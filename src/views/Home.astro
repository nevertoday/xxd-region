---
// 首页：先对新手说话（遇到过的事 → 三课入门 → 适不适合），最后是这个站讲的三件事，每件链到完整教程里对应的几步。
// 开头的标题和导语要让人五秒内看明白：给谁看、能学到什么、本站是非官方的、不是法律建议。
// 事实都出自 docs/sources/README.md 里的官方来源。
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { LESSONS, lessonHref, STEPS, stepHref, langOf, fullLang, t } from "../data/nav.js";
import { X as dict, fmt } from "../i18n/index.js";

const lang = langOf(Astro.url.pathname);
// 三件事里和语言无关的部分：图标、对应完整教程的哪几步。第一件是新手三课讲的那件，底色浅一点
const TRACK_BASE = [["UserPlus", [0, 1, 2, 3]], ["ArrowLeftRight", [4]], ["ShieldCheck", [5, 6]]];
const ZH = {
  brand: "外区 Apple ID 新手教程",
  h1: "要一个外区账户，又不动你的主账户",
  lead: ["写给住在中国大陆、想要一个美区或土区 Apple 账户的人：朋友推荐的 App 在国区搜不到，想用的服务国区没有。这里讲清楚账户的国家或地区管什么，Apple 自己的注册、付款和换区流程怎么走，怎么让 App Store 单独登一个外区账户、iCloud 一直是你自己的，以及订阅、礼品卡和账户被锁时该怎么办。", "这是一个非官方、开源的学习站", "，和 Apple 没有关系，不代表 Apple 的说法，也不是法律建议。"],
  cta: ["新手从这里开始", "看完整教程"],
  ctaNote: "新手入门一共三课：账户的地区管什么，iCloud 和 App Store 为什么是两个登录位，为什么另注册一个账户比给主账户换地区省事。",
  painH: "你是不是也遇到过这些",
  PAIN: [
    "朋友推荐了一个 App，你在国区的 App Store 里怎么搜都搜不到。",
    "想把 App Store 换成外区账户，又怕点错了退出登录，把 iCloud 里的照片和通讯录弄丢。",
    "网上的教程一篇一个说法：地址怎么填、付款选什么、要不要给主账户换地区，不知道该信哪个。",
  ],
  lessonsH: "新手只要三课",
  lessonsP: "按顺序看，一共二十多分钟。学完你会知道账户的地区管什么、Apple 的条款怎么说，为什么 iCloud 一直登你自己的账户、外区账户只登在「媒体与购买项目」里，也知道为什么另注册一个账户，比给主账户换地区省事。网站上别的内容，遇到了再查。",
  lessonsLabel: "新手入门：共 3 课",
  fitH: "适不适合你", yesH: "适合", noH: "本站不教",
  YES: ["你住在中国大陆，有一个自己在用的国区 Apple 账户", "你想要美区或土区才有的 App 或服务，愿意照 Apple 自己的流程来", "你想先弄懂规则，再决定要不要注册、怎么付款"],
  NO: ["具体的地址，或者地址怎么编", "网络设置：VPN、代理、节点", "共享账户，买来或借来的账户", "利用地区差价：低价区订阅、拼车、转卖"],
  tracksH: "这个网站讲三件事",
  tracksP: "新手三课先把道理讲清楚，完整教程再一步一步带你做。",
  TRACKS: [
    ["注册一个外区账户", "先想清楚要它做什么，再准备邮箱和手机号；注册时选对国家或地区，付款方式照 Apple 给那个地区列的来。"],
    ["只在「媒体与购买项目」里用它", "App Store 换成外区账户，下载、更新完再换回来，iCloud 一直登你自己的账户。"],
    ["订阅和账户安全", "订阅在哪管、涨价时 Apple 怎么通知你；账户被锁、购买被拒时找 Apple 官方，别买、别借、别分享账户。"],
  ],
  tracksLabel: "完整教程里对应的步骤",
  stepLink: (n, title) => `第 ${n} 步：${title}`,
};
const EN = {
  brand: "Apple Account regions, for beginners",
  h1: "An account in another region, without touching your main one",
  lead: ["For people who live in mainland China and want a US or Turkey Apple Account: the app a friend recommended isn't in the China mainland store, or the service you want isn't offered there. This site explains what an account's country or region decides, how Apple's own sign-up, payment and region-change flows work, how to sign the App Store into a second account while iCloud stays yours, and what to do about subscriptions, gift cards and locked accounts. ", "This is an unofficial, open-source guide", ", not affiliated with Apple, not speaking for Apple, and not legal advice."],
  cta: ["Start here if you're new", "Go to the full guide"],
  ctaNote: "The beginner track is three lessons: what an account's region decides, why iCloud and the App Store are two separate sign-ins, and why a second account is simpler than moving your main one to another region.",
  painH: "Has this happened to you?",
  PAIN: [
    "A friend recommended an app, and however you search, it isn't in your China mainland App Store.",
    "You want to switch the App Store to another region's account, but you're scared of tapping the wrong Sign Out and losing the photos and contacts in your iCloud.",
    "Every tutorial says something different about the address, the payment option and whether to move your main account, and you can't tell which to believe.",
  ],
  lessonsH: "Beginners need just three lessons",
  lessonsP: "Read them in order, about 25 minutes in all. By the end you'll know what an account's region decides and what Apple's terms say about it, why iCloud always stays on your own account while the other-region account goes only under Media & Purchases, and why a second account is simpler than moving your main one. Everything else on the site is there to look up when you need it.",
  lessonsLabel: "Beginner track: 3 lessons",
  fitH: "Is it for you?", yesH: "Yes, if", noH: "This site won't teach",
  YES: ["You live in mainland China and have a China mainland Apple Account of your own", "You want an app or service only the US or Turkey store has, and you're happy to follow Apple's own flows", "You want to understand the rules before you decide whether to sign up and how to pay"],
  NO: ["Specific addresses, or how to make one up", "Network setup: VPNs, proxies, nodes", "Shared accounts, or accounts bought or borrowed", "Price-gap tricks: cheap-region subscriptions, splitting plans, reselling"],
  tracksH: "What this site covers",
  tracksP: "The beginner track explains the ideas; the full guide then takes you through it step by step.",
  TRACKS: [
    ["Create an account in another region", "Know what you want it for, get an email address and phone number ready, pick the right country or region, and pay with what Apple lists for that region."],
    ["Use it under Media & Purchases only", "Switch the App Store to the other-region account, download and update, then switch back, with iCloud on your own account throughout."],
    ["Subscriptions and account safety", "Where to manage subscriptions and how Apple tells you about a price rise; when the account is locked or a purchase is refused, go to Apple, and don't buy, borrow or share accounts."],
  ],
  tracksLabel: "Matching steps in the full guide",
  stepLink: (n, title) => `Step ${n}: ${title}`,
};
// 其他语言：文字来自 src/i18n/<语言>.js；完整教程链到英文版
const x = dict(lang);
const fl = fullLang(lang);
const C = x
  ? { ...EN, ...x.home, brand: x.ui.brand, stepLink: (n, title) => fmt(x.home.stepLink, { n, title }) }
  : lang === "en" ? EN : ZH;
const TRACKS = TRACK_BASE.map(([icon, steps], i) => ({ icon, h: C.TRACKS[i][0], p: C.TRACKS[i][1], steps: steps.map((n) => STEPS.find((s) => s.n === n)) }));
const headings = [["h-pain", C.painH], ["h-lessons", C.lessonsH], ["h-fit", C.fitH], ["h-tracks", C.tracksH]].map(([slug, text]) => ({ slug, text, depth: 2 }));
---
<Site title={C.brand} headings={headings}>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead[0]}<mark>{C.lead[1]}</mark>{C.lead[2]}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={lessonHref(LESSONS[0], lang)}>{C.cta[0]}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" data-variant="ghost" href={stepHref(STEPS[0], fl)} hreflang={fl === lang ? undefined : fl}>{C.cta[1]}</a>
    </div>
    <p class="home__note">{C.ctaNote}</p>

    <section aria-labelledby="h-pain">
      <h2 id="h-pain">{C.painH}</h2>
      <ul class="pain">{C.PAIN.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section aria-labelledby="h-lessons">
      <h2 id="h-lessons">{C.lessonsH}</h2>
      <p>{C.lessonsP}</p>
      <ol class="xxd-steps roadmap" data-vertical aria-label={C.lessonsLabel}>
        {LESSONS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={lessonHref(s, lang)}>{t(s, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", lang)} · {t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.yesH}</h3><ul>{C.YES.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.noH}</h3><ul>{C.NO.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="h-tracks">
      <h2 id="h-tracks">{C.tracksH}</h2>
      <p>{C.tracksP}</p>
      {x && <p class="home__note">{C.devNote}</p>}
      <div class="flow">
        {TRACKS.map((k, i) => (
          <div class="flow__box" data-mine={i === 0 ? "" : undefined}>
            <i class="flow__icon" data-xxd-icon={k.icon} data-size="20"></i>
            <p class="flow__title">{k.h}</p>
            <p class="flow__desc">{k.p}</p>
            <ul class="flow__how" aria-label={C.tracksLabel}>
              {k.steps.map((s) => <li><a href={stepHref(s, fl)} hreflang={fl === lang ? undefined : fl}>{C.stepLink(s.n, t(s, "title", fl))}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <Contact />
  </div>
</Site>
