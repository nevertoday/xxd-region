---
// 待写：下面的首页文案还是跨境收款站的，写手照 docs/MAINTAINING.md 的「怎么写」重写，写完删掉这一行（npm run release 看到它会停下）。
// 首页：先对新手说话（遇到过的事 → 三课入门 → 适不适合），最后是这个站讲的三件事，每件链到完整教程里对应的几步。
// 开头的标题和导语要让人五秒内看明白：给谁看、能学到什么、本站是非官方的、不是法律或税务建议。
// 事实都出自 docs/sources/README.md 里的官方来源。
import Site from "../layouts/Site.astro";
import Contact from "../components/Contact.astro";
import { LESSONS, lessonHref, STEPS, stepHref, langOf, t } from "../data/nav.js";

const lang = langOf(Astro.url.pathname);
// 三件事里和语言无关的部分：图标、对应完整教程的哪几步。第一件是新手三课讲的那件，底色浅一点
const TRACK_BASE = [["Wallet", [0, 1, 2, 3]], ["Landmark", [4]], ["Calculator", [5]]];
const ZH = {
  brand: "跨境收款新手教程",
  h1: "海外的钱，怎么正规地回到你卡上",
  lead: ["写给住在中国大陆、从海外收钱的人：接了海外客户的活，做的内容有了收入，或者在海外平台开了网店。这里讲清楚选哪个正规的收款账户，每一段扣多少钱，为什么每人每年 5 万美元的额度不是上限，钱怎么换成人民币到你自己的卡上。", "这是一个非官方、开源的学习站", "，和 PayPal、Wise、Payoneer、万里汇或任何银行都没有关系，也不是法律或税务建议。"],
  cta: ["新手从这里开始", "看完整教程"],
  ctaNote: "新手入门一共三课：一笔钱回国要走的三段路，5 万美元额度是什么、不是什么，为什么账户只能用你自己的身份。",
  painH: "你是不是也遇到过这些",
  PAIN: [
    "海外客户说用 PayPal 付你，你却不知道住在国内能开哪种账户，钱又怎么回来。",
    "客户付了 100 美元，到你卡上的人民币却比按汇率算的少，不知道少在哪一段。",
    "听说一年只能换 5 万美元，收入快到这个数了，心里发慌。",
  ],
  lessonsH: "新手只要三课",
  lessonsP: "按顺序看，一共二十多分钟。学完你会知道一笔钱回国要经过哪三段、每一段的费用去哪里查，5 万美元额度管什么、不管什么，也知道为什么开户只能用你自己的身份和真实地址。网站上别的内容，遇到了再查。",
  lessonsLabel: "新手入门：共 3 课",
  fitH: "适不适合你", yesH: "适合", noH: "本站不教",
  YES: ["你住在中国大陆，用自己的身份证和自己名下的银行卡", "你收的是真实的收入：接活的服务费、内容收入、网店的货款", "你想先弄懂规则和费用，再决定开哪个账户"],
  NO: ["用不是你自己的地址或身份，去开美区、港区的 PayPal 或 Stripe", "拆分金额、借别人的额度，或者把汇款用途写成别的", "用加密货币换成人民币"],
  tracksH: "这个网站讲三件事",
  tracksP: "新手三课先把道理讲清楚，完整教程再一步一步带你做。",
  TRACKS: [
    ["选一个正规的收款账户", "按付钱的人来选：PayPal 的买家、电商平台、直接打款的客户。用你自己的身份开户，从第一天起留好凭证。"],
    ["把钱换成人民币到卡上", "让收款平台直接换成人民币打到卡上，或者先把美元电汇回国，再去银行结汇。"],
    ["算清每一段的费用", "收款费、换汇费、提现费各算各的，每个数字都写明出自哪一页、是哪天查的。"],
  ],
  tracksLabel: "完整教程里对应的步骤",
  stepLink: (n, title) => `第 ${n} 步：${title}`,
};
const EN = {
  brand: "Getting paid from abroad, for beginners",
  h1: "Getting money from abroad onto your own card, the legitimate way",
  lead: ["For people who live in mainland China and get paid from abroad: a client overseas, income from what you publish, or a shop on a foreign marketplace. This site explains which legitimate receiving account to pick, what each leg of the trip costs, why the USD 50,000 yearly quota isn't a ceiling, and how the money becomes RMB on your own card. ", "This is an unofficial, open-source guide", ", not affiliated with PayPal, Wise, Payoneer, WorldFirst or any bank, and not legal or tax advice."],
  cta: ["Start here if you're new", "Go to the full guide"],
  ctaNote: "The beginner track is three lessons: the three legs a payment takes home, what the USD 50,000 quota is and isn't, and why an account only works in your own name.",
  painH: "Has this happened to you?",
  PAIN: [
    "A client abroad wants to pay you by PayPal, and you don't know which account you can open living in China, or how the money gets home.",
    "A client paid you USD 100, the RMB on your card is less than the exchange rate says it should be, and you can't tell which leg it went missing on.",
    "You heard you can only change USD 50,000 a year, and your income is getting close.",
  ],
  lessonsH: "Beginners need just three lessons",
  lessonsP: "Read them in order, about 25 minutes in all. By the end you'll know the three legs a payment takes on its way home and where to look up each leg's fee, what the USD 50,000 quota covers and what it doesn't, and why you can only open an account with your own identity and real address. Everything else on the site is there to look up when you need it.",
  lessonsLabel: "Beginner track: 3 lessons",
  fitH: "Is it for you?", yesH: "Yes, if", noH: "This site won't teach",
  YES: ["You live in mainland China and use your own ID and a bank card in your own name", "The money is real income: fees for your work, creator income, sales from your shop", "You want to understand the rules and the fees before you pick an account"],
  NO: ["Opening a US or Hong Kong PayPal or Stripe account with an address or identity that isn't yours", "Splitting amounts, borrowing someone's quota, or writing a different purpose on a transfer", "Turning crypto into RMB"],
  tracksH: "What this site covers",
  tracksP: "The beginner track explains the ideas; the full guide then takes you through it step by step.",
  TRACKS: [
    ["Pick a legitimate receiving account", "Let your payer decide: PayPal buyers, marketplaces, clients who pay by bank transfer. Open it in your own name and keep the paper trail from day one."],
    ["Bring it home in RMB", "Let the provider pay RMB to your card, or wire USD home and settle it at your bank."],
    ["Add up each leg's fees", "Count the receiving, conversion and withdrawal fees separately, and note which page each number came from and the date you checked it."],
  ],
  tracksLabel: "Matching steps in the full guide",
  stepLink: (n, title) => `Step ${n}: ${title}`,
};
const C = lang === "en" ? EN : ZH;
const TRACKS = TRACK_BASE.map(([icon, steps], i) => ({ icon, h: C.TRACKS[i][0], p: C.TRACKS[i][1], steps: steps.map((n) => STEPS.find((s) => s.n === n)) }));
const headings = [["h-pain", C.painH], ["h-lessons", C.lessonsH], ["h-fit", C.fitH], ["h-tracks", C.tracksH]].map(([slug, text]) => ({ slug, text, depth: 2 }));
---
<Site title={C.brand} headings={headings}>
  <div class="home">
    <h1>{C.h1}</h1>
    <p class="home__lead">{C.lead[0]}<mark>{C.lead[1]}</mark>{C.lead[2]}</p>
    <div class="home__cta">
      <a class="xxd-btn" data-variant="primary" href={lessonHref(LESSONS[0], lang)}>{C.cta[0]}<i data-xxd-icon="ArrowRight" data-size="16"></i></a>
      <a class="xxd-btn" data-variant="ghost" href={stepHref(STEPS[0], lang)}>{C.cta[1]}</a>
    </div>
    <p class="home__note">{C.ctaNote}</p>

    <section aria-labelledby="h-pain">
      <h2 id="h-pain">{C.painH}</h2>
      <ul class="pain">{C.PAIN.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section aria-labelledby="h-lessons">
      <h2 id="h-lessons">{C.lessonsH}</h2>
      <p>{C.lessonsP}</p>
      <ol class="xxd-steps roadmap" data-vertical aria-label={C.lessonsLabel}>
        {LESSONS.map((s) => (
          <li class="xxd-steps__item">
            <span class="xxd-steps__mark" aria-hidden="true">{s.n}</span>
            <span class="xxd-steps__text">
              <a class="xxd-steps__title xxd-steps__link" href={lessonHref(s, lang)}>{t(s, "title", lang)}</a>
              <span class="xxd-steps__desc">{t(s, "minutes", lang)} · {t(s, "sum", lang)}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="h-fit">
      <h2 id="h-fit">{C.fitH}</h2>
      <div class="fit">
        <div class="route"><h3><i data-xxd-icon="CircleCheck" data-size="18"></i>{C.yesH}</h3><ul>{C.YES.map((x) => <li>{x}</li>)}</ul></div>
        <div class="route"><h3><i data-xxd-icon="CircleX" data-size="18"></i>{C.noH}</h3><ul>{C.NO.map((x) => <li>{x}</li>)}</ul></div>
      </div>
    </section>

    <section aria-labelledby="h-tracks">
      <h2 id="h-tracks">{C.tracksH}</h2>
      <p>{C.tracksP}</p>
      <div class="flow">
        {TRACKS.map((k, i) => (
          <div class="flow__box" data-mine={i === 0 ? "" : undefined}>
            <i class="flow__icon" data-xxd-icon={k.icon} data-size="20"></i>
            <p class="flow__title">{k.h}</p>
            <p class="flow__desc">{k.p}</p>
            <ul class="flow__how" aria-label={C.tracksLabel}>
              {k.steps.map((s) => <li><a href={stepHref(s, lang)}>{C.stepLink(s.n, t(s, "title", lang))}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <Contact />
  </div>
</Site>
