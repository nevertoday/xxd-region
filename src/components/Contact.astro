---
// 首页、常见问题末尾的「提问和讨论」卡片（xxd 分层卡片 LayerCard）：到 GitHub 提问、讨论、分享经验；
// 作者的 X 只是一个安静的文字链接。下面洗色的一条：发截图前先打码（账户邮箱、手机号、礼品卡号贴出去，别人就能拿去用）。
import { langOf, link, REPO } from "../data/nav.js";
const lang = langOf(Astro.url.pathname);
const en = lang === "en";
const onFaq = Astro.url.pathname.replace(/\/$/, "").endsWith("/faq");
const ISSUE = `${REPO}/issues/new`;
const X = "https://x.com/xiaoxiaodong";
const T = en
  ? {
      h: "Questions and discussion",
      p: "Stuck on a step, found something unclear, or hit an error message the guide doesn't cover? Bring it to GitHub. The questions that come up most get worked into the guide.",
      faq: ["Before asking, check the ", "FAQ", ": many answers are already there."],
      btn: "Ask or discuss on GitHub",
      x: "The author is on X",
      privacy: "Before sending screenshots, blur out your Apple Account email, phone number, card or gift card codes, order numbers and your name.",
    }
  : {
      h: "提问和讨论",
      p: "卡在哪一步、哪里没写清楚，或者碰到了教程里没写的提示，都欢迎到 GitHub 上提出来。问得多的，我会补进教程。",
      faq: ["问之前可以先看看", "常见问题", "，很多答案已经在那里了。"],
      btn: "到 GitHub 提问或讨论",
      x: "作者在 X 上",
      privacy: "发截图前，先把 Apple 账户的邮箱、手机号、银行卡和礼品卡的号码、订单号和你的名字打码。",
    };
---
<section class="xxd-layer contact" aria-labelledby="h-contact">
  <div class="xxd-layer__primary contact__body">
    <h2 id="h-contact">{T.h}</h2>
    <p>{T.p}</p>
    {!onFaq && <p class="contact__faq">{T.faq[0]}<a href={link("/faq/", lang)}>{T.faq[1]}</a>{T.faq[2]}</p>}
    <div class="contact__btns">
      <a class="xxd-btn" href={ISSUE} rel="noopener"><i data-xxd-icon="MessagesSquare" data-size="16"></i>{T.btn}</a>
      <a class="xxd-link contact__x" href={X} rel="noopener">{T.x}<i data-xxd-icon="ArrowUpRight" data-size="14"></i></a>
    </div>
  </div>
  <p class="xxd-layer__secondary contact__note"><i data-xxd-icon="EyeOff" data-size="14"></i>{T.privacy}</p>
</section>
